<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EService.ViewModels"
             x:Class="EService.Views.UserManagementView"
             x:DataType="vm:UserManagementViewModel"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource BrushBackground}">

        <Border Grid.Row="0" Background="{StaticResource BrushPrimary}" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="nav" Content="🏠 Inicio" Command="{Binding HomeCommand}" />
                <TextBlock Grid.Column="1" Text="Gestión de Empleados" Foreground="White" FontSize="20"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="nav" Content="← Panel de Gerente" Command="{Binding VolverCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="260,*" Margin="20">

            <Border Grid.Column="0" Classes="card" Margin="0,0,10,0" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock Text="Acciones" Classes="h2" />
                    <Button Content="Agregar Empleado" Classes="primary" Command="{Binding AgregarUsuarioCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Content="Modificar Rol" Classes="secondary" Command="{Binding ModificarUsuarioCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Content="Eliminar Empleado" Classes="danger" Command="{Binding EliminarUsuarioCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card" Margin="10,0,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="Empleados Registrados" Classes="h2" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Usuarios}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UserRowViewModel">
                                    <Border Background="{StaticResource BrushBackground}" CornerRadius="8"
                                            Padding="14,10" Margin="4">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Codigo}" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="{Binding TipoUsuario}" Classes="subtle" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>

</UserControl>
