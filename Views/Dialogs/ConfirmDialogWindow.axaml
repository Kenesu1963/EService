<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EService.Views.Dialogs.ConfirmDialogWindow"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSurface}">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock x:Name="TitleText" Classes="h2" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Cancelar" Classes="secondary" Click="OnNoClick" />
            <Button Content="Confirmar" Classes="primary" Click="OnYesClick" />
        </StackPanel>
    </StackPanel>
</Window>
