<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EService.Views.Dialogs.MessageDialogWindow"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSurface}">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock x:Name="TitleText" Classes="h2" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <Button Content="Aceptar" Classes="primary" HorizontalAlignment="Right"
                Click="OnOkClick" />
    </StackPanel>
</Window>
