<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EService.ViewModels"
             x:Class="EService.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource BrushBackground}">

        <Border Grid.Row="0" Background="{StaticResource BrushPrimary}" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="nav" Content="🏠 Inicio" Command="{Binding HomeCommand}" />
                <TextBlock Grid.Column="1" Text="Inventario Actual" Foreground="White" FontSize="20"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="nav" Content="← Panel de Gerente" Command="{Binding VolverCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card" Margin="20">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="90,*,110,80" Margin="8,0,8,8">
                    <TextBlock Grid.Column="0" Text="Código" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="Nombre" FontWeight="Bold" />
                    <TextBlock Grid.Column="2" Text="Cantidad" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Unidad" FontWeight="Bold" HorizontalAlignment="Right" />
                </Grid>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Insumos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InsumoRowViewModel">
                                <Border Padding="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="90,*,110,80">
                                        <TextBlock Grid.Column="0" Text="{Binding Codigo}" Classes="subtle" />
                                        <TextBlock Grid.Column="1" Text="{Binding Nombre}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CantidadTexto}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding Unidad}" Classes="subtle" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>

</UserControl>
